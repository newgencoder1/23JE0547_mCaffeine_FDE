# Copy to .env for local development and fill in values. Never commit .env.
# On Render, set the same names under Environment.

# Supabase Postgres connection string. On Render use the "Session pooler"
# string (IPv4); the direct connection is IPv6-only on the free plan.
DATABASE_URL=

# Long random string used to sign session cookies.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Supabase project URL and service-role key (server-side only; never sent to browsers)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Name of the PRIVATE storage bucket for original PDFs
STORAGE_BUCKET=

# Optional OCR fallback for PDFs whose text layer is missing or garbled (true/false)
OCR_ENABLED=

# true in production (HTTPS). Set to false only for local http://localhost
SESSION_COOKIE_SECURE=

# INFO or DEBUG
LOG_LEVEL=

# Used only by scripts/seed_users.py to set the password of the four test users
SEED_PASSWORD=
